      "targets": [
        "tests/planner/cut.examples.test.ts"
      ],
      "depends_on": [
        "cut-component"
      ]
    },
    "cut-judges-judge": {
      "targets": [
        "tests/planner/judges.examples.test.ts"
      ],
      "depends_on": [
        "cut-judges"
      ]
    },
    "plan-spec-judge": {
      "targets": [
        "tests/planner/plan.examples.test.ts"
      ],
      "depends_on": [
        "plan-spec"
      ]
    },
    "plan-command-judge": {
      "targets": [
        "tests/cli/planCommand.examples.test.ts",
        "tests/cli/main.examples.test.ts"
      ],
      "depends_on": [
        "plan-command",
        "parse-command"
      ]
