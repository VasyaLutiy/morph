      ]
    },
    "cut-component": {
      "targets": [
        "src/planner/cut.ts"
      ],
      "depends_on": [
        "render"
      ]
    },
    "cut-judges": {
      "targets": [
        "src/planner/judges.ts"
      ],
      "depends_on": [
        "render"
      ]
    },
    "plan-spec": {
      "targets": [
        "src/planner/plan.ts"
      ],
      "depends_on": [
        "cut-component",
