{
  "groups": {
    "parse-command": [
      "Parse Command"
    ],
    "render": [
      "Render Examples",
      "Render Function",
      "Render Context",
      "Card Budget"
    ],
    "cut-component": [
      "Cut Units",
      "Cut Component"
    ],
    "plan-spec": [
      "Order Deck",
      "Plan Spec"
    ]
  },
