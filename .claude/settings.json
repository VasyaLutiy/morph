{
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "tools/tg-hook.sh stop" } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "tools/tg-hook.sh notification" } ] }
    ]
  }
}

{
  "permissions": {
    "allow": [
      "Bash(/tmp/oldscheme/*/morph.sh:*)",
      "Bash(nohup /tmp/oldscheme/*/morph.sh:*)"
    ]
  }
}
